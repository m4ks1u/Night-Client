{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capability for the main window: the app commands listed in build.rs plus the window controls the custom title bar needs. No filesystem, shell or HTTP access is exposed to the WebView.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-ui-ready",
    "allow-app-info",
    "allow-system-info",
    "allow-get-settings",
    "allow-update-settings",
    "allow-diagnostics",
    "allow-recent-logs",
    "allow-open-data-dir",
    "allow-open-logs-dir",
    "allow-list-versions",
    "allow-install-version",
    "allow-cancel-download",
    "allow-download-queue",
    "allow-download-history",
    "allow-clear-download-history",
    "allow-detect-java",
    "allow-set-instance-java",
    "allow-list-instances",
    "allow-get-instance",
    "allow-create-instance",
    "allow-update-instance",
    "allow-delete-instance",
    "allow-open-instance-dir",
    "allow-set-instance-jvm-args",
    "allow-loader-versions",
    "allow-set-instance-loader-version",
    "allow-set-instance-game-dir",
    "allow-pick-folder",
    "allow-modrinth-search",
    "allow-modrinth-project",
    "allow-modrinth-categories",
    "allow-open-modrinth-page",
    "allow-show-snap-layouts",
    "allow-mod-install-plan",
    "allow-mod-install",
    "allow-list-mods",
    "allow-set-mod-enabled",
    "allow-remove-mod",
    "allow-check-mod-updates",
    "allow-update-mods",
    "allow-import-local-mod",
    "allow-account",
    "allow-sign-in",
    "allow-cancel-sign-in",
    "allow-list-accounts",
    "allow-check-active-account",
    "allow-switch-account",
    "allow-remove-account",
    "allow-running-instances",
    "allow-launch-instance",
    "allow-stop-instance"
  ]
}
