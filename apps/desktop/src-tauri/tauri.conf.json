{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Night Client",
  "version": "0.0.1",
  "identifier": "app.nightclient.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Night Client",
        "width": 1180,
        "height": 740,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0b0b10",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://cdn.modrinth.com; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Night Client contributors",
    "copyright": "Night Client contributors. Not affiliated with Mojang Studios or Microsoft.",
    "shortDescription": "Minecraft: Java Edition launcher",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
